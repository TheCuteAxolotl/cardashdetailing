generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]
  vehicles     Vehicle[]
  quoteThreads QuoteThread[]
  warranties   Warranty[]
  customRoleAssignments CustomRoleAssignment[]
  permissionOverrides UserPermissionOverride[]
}

model Vehicle {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname     String?
  year         String
  make         String
  model        String
  trim         String?
  vehicleType  String        @default("Sedan")
  color        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookings     Booking[]
  quoteThreads QuoteThread[]
  warranties   Warranty[]

  @@index([userId, createdAt])
}

model Service {
  id            String        @id @default(cuid())
  title         String
  description   String
  price         Float         @default(0)
  startingPrice Float?
  maxPrice      Float?
  pricingType   String        @default("fixed") // fixed, starting, range, quote
  category      String        @default("Car Detailing")
  subcategory   String        @default("General")
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  quoteThreads  QuoteThread[]
}

model Booking {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String?
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceName    String
  serviceMethod  String   @default("shop")
  customerName   String
  customerEmail  String
  customerPhone  String
  vehicleMake    String
  vehicleModel   String
  vehicleYear    String
  vehicleTrim    String?
  preferredDate  String?
  preferredTime  String?
  quotedPrice    Float?   // exact booking total for new V3 bookings
  notes          String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  conversation   BookingConversation?
}


model BookingConversation {
  id                 String           @id @default(cuid())
  bookingId          String           @unique
  booking            Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lastCustomerSeenAt DateTime?
  lastStaffSeenAt    DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           BookingMessage[]
}

model BookingMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   BookingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String              // customer, team, system
  body           String
  channel        String              @default("web") // web, sms, system
  externalSid    String?             @unique
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model UnmatchedSmsMessage {
  id          String   @id @default(cuid())
  fromPhone   String
  toPhone     String?
  body        String
  externalSid String   @unique
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model QuoteThread {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId          String?
  vehicle            Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceId          String?
  service            Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  subject            String
  status             String         @default("open") // open, quoted, accepted, booked, closed
  quotedPrice        Float?
  quoteNotes         String?
  acceptedAt         DateTime?
  lastCustomerSeenAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  messages           QuoteMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model QuoteMessage {
  id              String      @id @default(cuid())
  threadId        String
  thread          QuoteThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender          String      // customer, team
  body            String
  attachmentsJson String?     // JSON array of small image data URLs (temporary storage strategy)
  createdAt       DateTime    @default(now())

  @@index([threadId, createdAt])
}

model Warranty {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  coatingName    String
  durationYears  Int
  installedAt    DateTime
  expiresAt      DateTime
  status         String   @default("active")
  installerNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, expiresAt])
}

model Review {
  id        String   @id @default(cuid())
  name      String
  email     String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  title     String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id                String           @id @default(cuid())
  accessKeyHash     String
  visitorHash       String
  name              String
  email             String?
  phone             String?
  contactPreference String           @default("website")
  subject           String
  status            String           @default("open")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  messages          SupportMessage[]

  @@index([visitorHash])
  @@index([createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model BlockedVisitor {
  id        String   @id @default(cuid())
  hash      String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model BlockedCaller {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  reason      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model CallLog {
  id                       String    @id @default(cuid())
  callSid                  String    @unique
  fromPhone                String
  toPhone                  String?
  status                   String    @default("received")
  blocked                  Boolean   @default(false)
  dialCallSid              String?
  durationSeconds          Int?
  screenAccepted           Boolean   @default(false)
  voicemailRecordingSid    String?
  voicemailRecordingUrl    String?
  voicemailDurationSeconds Int?
  voicemailAt              DateTime?
  startedAt                DateTime  @default(now())
  endedAt                  DateTime?

  @@index([startedAt])
  @@index([fromPhone, startedAt])
}


model CustomRole {
  id              String                 @id @default(cuid())
  name            String                 @unique
  description     String?
  permissionsJson String                 @default("[]")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assignments     CustomRoleAssignment[]
}

model CustomRoleAssignment {
  id        String     @id @default(cuid())
  userId    String
  roleId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserPermissionOverride {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  allowed    Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, permission])
  @@index([userId])
}
